# Wzór pliku .env — skopiuj go jako .env i wpisz własne wartości.
#
# Znajdziesz je w panelu Supabase: Project Settings -> API
#   EXPO_PUBLIC_SUPABASE_URL       = pole "Project URL"
#   EXPO_PUBLIC_SUPABASE_ANON_KEY  = klucz "anon public"
#
# Klucza "service_role" NIE wpisuj tutaj ani nigdzie w kodzie.

EXPO_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=twoj-klucz-anon-public
