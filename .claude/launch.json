      "name": "strona-statyczna",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path'),root='C:/Users/romitu/AppData/Local/Temp/claude/6dd64fef79862c9e/48b237bd-7c37-4791-9395-262b93b43c09/scratchpad/strona',t={'.html':'text/html; charset=utf-8','.jpg':'image/jpeg','.png':'image/png','.svg':'image/svg+xml'};h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/index.html';const n=p.join(root,u);if(!n.startsWith(p.normalize(root))){r.writeHead(403);return r.end()}f.readFile(n,(e,d)=>{if(e){r.writeHead(404);return r.end('404')}r.writeHead(200,{'Content-Type':t[p.extname(n)]||'application/octet-stream'});r.end(d)})}).listen(8766)"
